{
  "id": "a1000000-0000-4000-8000-000000000001",
  "version": "2.0",
  "name": "InternHub_STQA_Project",
  "url": "https://intern-hub-blue.vercel.app",
  "tests": [
    {
      "id": "c0000001-0000-4000-8000-000000000001",
      "name": "TC01_Admin_Login",
      "commands": [
        {
          "id": "1001-01",
          "comment": "Open InternHub landing page with signin modal triggered",
          "command": "open",
          "target": "/?signin=true",
          "targets": [],
          "value": ""
        },
        {
          "id": "1001-02",
          "comment": "Wait for Sign In modal dialog to appear",
          "command": "waitForElementPresent",
          "target": "xpath=//h2[@id='auth-modal-title']",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "1001-03",
          "comment": "Click Continue with Email",
          "command": "click",
          "target": "xpath=//button[contains(.,'Continue with Email')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "1001-04",
          "comment": "Wait for Email input",
          "command": "waitForElementPresent",
          "target": "xpath=//input[@type='email']",
          "targets": [],
          "value": "5000"
        },
        {
          "id": "1001-05",
          "comment": "Enter admin email (replace with your live admin email if different)",
          "command": "type",
          "target": "xpath=//input[@type='email']",
          "targets": [],
          "value": "admin@coreco.com"
        },
        {
          "id": "1001-06",
          "comment": "Enter admin password (replace with your live admin password if different)",
          "command": "type",
          "target": "xpath=//input[@type='password']",
          "targets": [],
          "value": "admin123"
        },
        {
          "id": "1001-07",
          "comment": "Click Sign in button",
          "command": "click",
          "target": "xpath=//form//button[contains(.,'Sign in')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "1001-08",
          "comment": "Verify successful toast or redirection to admin dashboard",
          "command": "waitForElementPresent",
          "target": "xpath=//*[contains(text(),'Welcome back!') or contains(text(),'Dashboard')]",
          "targets": [],
          "value": "10000"
        }
      ]
    },
