    {
      "id": "c0000012-0000-4000-8000-000000000012",
      "name": "TC12_Password_Mismatch",
      "commands": [
        {
          "id": "1012-01",
          "comment": "Open sign-up modal directly",
          "command": "open",
          "target": "/?signup=true",
          "targets": [],
          "value": ""
        },
        {
          "id": "1012-02",
          "comment": "Wait for modal to appear",
          "command": "waitForElementPresent",
          "target": "xpath=//h2[@id='auth-modal-title']",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "1012-03",
          "comment": "Click Sign up with Email",
          "command": "click",
          "target": "xpath=//button[contains(.,'Sign up with Email')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "1012-04",
          "comment": "Fill Company Name",
          "command": "type",
          "target": "xpath=//input[@placeholder='Acme Technologies']",
          "targets": [],
          "value": "STQA Quality Testing Ltd"
        },
        {
          "id": "1012-05",
          "comment": "Fill User Name",
          "command": "type",
          "target": "xpath=//input[@placeholder='Full name']",
          "targets": [],
          "value": "Tester Admin"
        },
        {
          "id": "1012-06",
          "comment": "Fill Work Email",
          "command": "type",
          "target": "xpath=//input[@placeholder='you@company.com']",
          "targets": [],
          "value": "tester@stqaquality.io"
        },
        {
          "id": "1012-07",
          "comment": "Fill Password",
          "command": "type",
          "target": "xpath=//input[@placeholder='Min 8 characters']",
          "targets": [],
          "value": "Password123!"
        },
        {
          "id": "1012-08",
          "comment": "Fill Mismatched Confirm Password",
          "command": "type",
          "target": "xpath=//input[@placeholder='Repeat password']",
          "targets": [],
          "value": "CompletelyDifferentPassword999!"
        },
        {
          "id": "1012-09",
          "comment": "Click Create Account button",
          "command": "click",
          "target": "xpath=//form//button[contains(.,'Create Account')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "1012-10",
          "comment": "Assert that client validation displays 'Passwords don't match' toast",
          "command": "waitForElementPresent",
          "target": "xpath=//*[contains(text(),\"Passwords don't match\")]",
          "targets": [],
          "value": "10000"
        }
      ]
    },
